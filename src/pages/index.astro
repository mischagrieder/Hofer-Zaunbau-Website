---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion.astro';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import Reveal from '../components/Reveal.astro';
import Section from '../components/Section.astro';
import { faq, products, services, site, steps } from '../data/site';
import { image } from '../lib/images';

const featured = products.filter((product) =>
  ['metallzaeune', 'holzzaeune', 'sichtschutz'].includes(product.slug),
);

const promises = [
  'Beratung und Aufmass bei Ihnen vor Ort',
  'Eigene Werkstatt für Sonderteile',
  'Montage oder Anleitung zur Selbstmontage',
];

const galleryPreview = ['tor', 'industriezaun', 'montage'] as const;
const galleryAlt: Record<(typeof galleryPreview)[number], string> = {
  tor: 'Anthrazitfarbenes Schiebetor an einer Einfahrt, halb geöffnet',
  industriezaun: 'Doppelstabmattenzaun entlang eines Gewerbeareals',
  montage: 'Hände richten mit der Wasserwaage einen frisch gesetzten Zaunpfosten aus',
};
---

<BaseLayout
  title={`${site.name} | Zäune, Tore und Sichtschutz in Rothrist`}
  description={site.description}
  bareTitle
>
  <!-- Aufmacher: geteiltes Raster. Die Schrift steht auf ruhigem Papierton,
       das Bild läuft rechts bis an den Bildschirmrand. Kein Text auf Bild,
       dadurch bleibt der Kontrast unabhängig vom Motiv verlässlich. -->
  <section class="border-b border-grey-200">
    <div class="grid items-stretch lg:grid-cols-2">
      <div class="bleed-start flex items-center py-16 lg:py-28">
        <div class="w-full lg:max-w-[36rem]">
          <Eyebrow>Zaunbau aus Rothrist, seit {site.foundedYear}</Eyebrow>

          <h1 class="mt-7 font-display text-display">
            Ein Zaun, der die Linie hält.
          </h1>

          <p class="measure mt-7 text-lead text-grey-700">
            Wir planen, liefern und montieren Zäune aus Metall, Holz und
            Kunststoff, dazu Tore, Sichtschutz und Schlosserarbeiten. Sauber
            gesetzt, exakt ausgerichtet und auf Jahrzehnte gedacht.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
            <Button href="/kontakt/" icon="arrow">Offerte anfragen</Button>
            <a
              href="/leistungen/"
              class="link-underline font-medium text-grey-700 transition-colors duration-200 hover:text-ink"
            >
              Leistungen ansehen
            </a>
          </div>

          <ul class="mt-12 space-y-3 border-t border-grey-200 pt-8">
            {
              promises.map((promise) => (
                <li class="flex items-start gap-3 text-[0.9375rem] text-grey-700">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-brand-800" />
                  <span>{promise}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="relative min-h-[22rem] lg:min-h-[44rem]">
        <Image
          src={image('hero')}
          alt="Anthrazitfarbener Metallzaun mit senkrechten Stäben entlang des Vorgartens eines modernen Schweizer Einfamilienhauses"
          widths={[720, 1080, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Leistungen -->
  <Section labelledby="leistungen-titel" tone="white">
    <div class="container-page">
      <Reveal class="max-w-3xl">
        <Eyebrow>Leistungen</Eyebrow>
        <h2 id="leistungen-titel" class="mt-6 font-display text-h2">
          Von der Beratung bis zum letzten Pfosten.
        </h2>
        <p class="measure mt-6 text-lead text-grey-700">
          Alles aus einer Hand: Sie sprechen mit derselben Person, die später
          auch auf der Baustelle steht.
        </p>
      </Reveal>

      <ul class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service, index) => (
            <Reveal as="li" delay={(index % 4) * 70}>
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-50 text-brand-800">
                <Icon name={service.icon} size={22} />
              </span>
              <h3 class="mt-5 font-display text-h3">{service.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-grey-700">
                {service.summary}
              </p>
            </Reveal>
          ))
        }
      </ul>

      <Reveal class="mt-14">
        <Button href="/leistungen/" variant="secondary" icon="arrow">
          Alle Leistungen im Detail
        </Button>
      </Reveal>
    </div>
  </Section>

  <!-- Produkte -->
  <Section labelledby="produkte-titel">
    <div class="container-page">
      <Reveal class="flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-2xl">
          <Eyebrow>Produkte</Eyebrow>
          <h2 id="produkte-titel" class="mt-6 font-display text-h2">
            Material, das zu Ihrem Grundstück passt.
          </h2>
        </div>
        <Button href="/produkte/" variant="secondary" icon="arrow">
          Alle Produkte
        </Button>
      </Reveal>

      <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
        {
          featured.map((product, index) => (
            <Reveal delay={index * 90}>
              <ProductCard product={product} />
            </Reveal>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Ablauf -->
  <Section labelledby="ablauf-titel" tone="white">
    <div class="container-page">
      <Reveal class="max-w-2xl">
        <Eyebrow>Ablauf</Eyebrow>
        <h2 id="ablauf-titel" class="mt-6 font-display text-h2">
          In vier Schritten zum fertigen Zaun.
        </h2>
      </Reveal>

      <ol class="mt-16 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, index) => (
            <Reveal as="li" delay={index * 80} class="relative">
              <span
                aria-hidden="true"
                class="font-display text-5xl font-semibold text-grey-300"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <span
                aria-hidden="true"
                class="mt-5 block h-px w-full bg-grey-200"
              />
              <h3 class="mt-6 font-display text-h3">{step.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-grey-700">
                {step.text}
              </p>
            </Reveal>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- Referenzen -->
  <Section labelledby="referenzen-titel">
    <div class="container-page">
      <Reveal class="flex flex-wrap items-end justify-between gap-8">
        <div class="max-w-2xl">
          <Eyebrow>Referenzen</Eyebrow>
          <h2 id="referenzen-titel" class="mt-6 font-display text-h2">
            Ein Blick auf unsere Arbeit.
          </h2>
        </div>
        <Button href="/referenzen/" variant="secondary" icon="arrow">
          Zur Galerie
        </Button>
      </Reveal>

      <div class="mt-14 grid gap-4 sm:grid-cols-3">
        {
          galleryPreview.map((name, index) => (
            <Reveal delay={index * 90} class="overflow-hidden rounded-panel bg-grey-200">
              <Image
                src={image(name)}
                alt={galleryAlt[name]}
                widths={[400, 640, 900]}
                sizes="(min-width: 640px) 31vw, 92vw"
                loading="lazy"
                class="aspect-4/5 w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] hover:scale-[1.04]"
              />
            </Reveal>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Über uns -->
  <Section labelledby="ueberuns-titel" tone="white">
    <div class="container-page grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <Reveal class="lg:col-span-5">
        <div class="overflow-hidden rounded-panel bg-grey-200">
          <Image
            src={image('werkstatt')}
            alt="Aufgeräumte Metallwerkstatt mit einer Rohrrahmentür auf dem Schweisstisch"
            widths={[480, 720, 1000]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            loading="lazy"
            class="aspect-4/3 w-full object-cover"
          />
        </div>
      </Reveal>

      <Reveal class="lg:col-span-7">
        <Eyebrow>Über uns</Eyebrow>
        <h2 id="ueberuns-titel" class="mt-6 font-display text-h2">
          Ein Betrieb, eine Ansprechperson.
        </h2>
        <p class="measure mt-6 text-lead text-grey-700">
          {site.name} ist seit {site.foundedYear} in Rothrist zuhause. Geführt von
          {' '}{site.owner}, mit eigener Werkstatt an der {site.workshop.street}.
          Was sich nicht ab Lager lösen lässt, entsteht dort auf Mass.
        </p>
        <p class="measure mt-5 text-grey-700">
          Wir arbeiten für Private, Gewerbe und Gemeinden in Rothrist und der
          ganzen Region rundherum. Kurze Wege, verbindliche Termine und eine
          Offerte, die am Ende auch stimmt.
        </p>

        <div class="mt-9">
          <Button href="/ueber-uns/" variant="secondary" icon="arrow">
            Mehr über den Betrieb
          </Button>
        </div>
      </Reveal>
    </div>
  </Section>

  <!-- Fragen -->
  <Section labelledby="faq-titel">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
      <Reveal class="lg:col-span-4">
        <Eyebrow>Fragen</Eyebrow>
        <h2 id="faq-titel" class="mt-6 font-display text-h2">Gut zu wissen.</h2>
        <p class="measure mt-6 text-grey-700">
          Ihre Frage ist nicht dabei? Rufen Sie an, wir beantworten sie direkt.
        </p>
      </Reveal>

      <Reveal class="lg:col-span-8">
        <Accordion items={faq} />
      </Reveal>
    </div>
  </Section>

  <CtaBand />
</BaseLayout>
