---
import Picture from './Picture.astro';

/**
 * Eingangssequenz: Blick durch ein Loch im Maschendrahtzaun.
 *
 * Beim Öffnen sieht man nur den Zaun. Durch das Loch in der Mitte ist bereits
 * das Aufmacherbild zu erkennen. Beim Scrollen wächst der Zaun vom
 * Lochmittelpunkt aus über den Bildschirm hinaus, man geht also durch das Loch
 * hindurch, danach beginnt die Seite.
 *
 * Aufbau
 * - Ein hoher Rahmen erzeugt die nötige Scrollstrecke.
 * - Darin klebt eine Bühne über die volle Bildschirmhöhe.
 * - Hinter dem Zaun liegt dasselbe Aufmacherbild wie im Abschnitt darunter,
 *   dadurch geht der Übergang ohne Bruch weiter.
 * - Der Zaun ist eine weisse Fläche, aus der das Loch ausgespart ist. Nur
 *   dort wird das Bild sichtbar.
 *
 * Bewusste Entscheidungen
 * - Die Sequenz wird erst durch JavaScript eingeschaltet. Ohne JavaScript
 *   bleibt sie unsichtbar und die Seite beginnt sofort mit dem Aufmacher.
 *   Eine Scrollstrecke, die man ohne Skript nicht überwinden kann, wäre eine
 *   Falle.
 * - Bei reduzierter Bewegung entfällt sie ebenfalls vollständig.
 * - Bewegt werden nur transform und opacity, beide laufen auf dem Compositor.
 *   Der Fortschritt wird in einem rAF gebündelt, der Scroll-Listener ist
 *   passiv.
 * - Für Hilfsmittel ist die Sequenz ausgeblendet, sie trägt keine Information.
 */

/* Deterministischer Zufall. Der gleiche Startwert liefert bei jedem Build
   dieselben Linien, sonst würde sich das Markup bei jedem Bauen ändern. */
let seed = 20160412;
const rnd = () => {
  seed = (seed * 1664525 + 1013904223) % 4294967296;
  return seed / 4294967296;
};

const W = 1000;
const H = 700;
const CX = W / 2;
const CY = H / 2;

/** Unregelmässiges Loch, angelehnt an aufgetrenntes Geflecht. */
const holePoints = Array.from({ length: 26 }, (_, i) => {
  const a = (i / 26) * Math.PI * 2;
  const r = 165 + Math.sin(a * 3) * 22 + (rnd() - 0.5) * 34;
  return [CX + Math.cos(a) * r * 1.12, CY + Math.sin(a) * r * 0.96];
});

const holePath =
  holePoints
    .map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`)
    .join(' ') + ' Z';

/**
 * Eine Drahtlinie mit leichtem Schlenker. Die kleinen Knicke alle paar Schritte
 * stehen für die Verdrillung an den Kreuzungspunkten, dadurch wirkt das
 * Geflecht handgezogen statt technisch gerastert.
 */
const wire = (x0: number, y0: number, dx: number, dy: number, len: number) => {
  /* Schrittweite und Genauigkeit sind bewusst grob. Bei 26 Pixeln und einer
     Nachkommastelle wog dieses SVG 74 KB, die Hälfte der ganzen Seite. Mit 46
     Pixeln und ganzen Zahlen bleibt der handgezogene Eindruck erhalten, das
     Markup schrumpft aber auf ein Viertel. */
  const steps = Math.ceil(len / 46);
  let d = `M${Math.round(x0)} ${Math.round(y0)}`;

  for (let i = 1; i <= steps; i += 1) {
    const t = (i / steps) * len;
    const wobble = Math.sin(i * 2.3) * 4.4 + (rnd() - 0.5) * 3;
    const x = x0 + dx * t - dy * wobble;
    const y = y0 + dy * t + dx * wobble;
    d += ` L${Math.round(x)} ${Math.round(y)}`;
  }

  return d;
};

const SPACING = 68;
const DIAG = Math.SQRT1_2;
const span = W + H;

/* Zwei Scharen diagonaler Drähte bilden das Rautengeflecht. */
const wiresDown = Array.from({ length: Math.ceil(span / SPACING) + 2 }, (_, i) =>
  wire(-H + i * SPACING, -40, DIAG, DIAG, span * 1.2),
);
const wiresUp = Array.from({ length: Math.ceil(span / SPACING) + 2 }, (_, i) =>
  wire(-H + i * SPACING, H + 40, DIAG, -DIAG, span * 1.2),
);

/** Abgerissene Drahtenden, die in das Loch hineinragen. */
const stubs = Array.from({ length: 18 }, (_, i) => {
  const a = (i / 18) * Math.PI * 2 + 0.15;
  const r = 150 + (rnd() - 0.5) * 26;
  const x = CX + Math.cos(a) * r * 1.12;
  const y = CY + Math.sin(a) * r * 0.96;
  const len = 10 + rnd() * 13;
  const kink = (rnd() - 0.5) * 26;

  return (
    `M${x.toFixed(1)} ${y.toFixed(1)} ` +
    `l${(Math.cos(a) * -len * 0.5).toFixed(1)} ${(Math.sin(a) * -len * 0.5 + kink * 0.3).toFixed(1)} ` +
    `l${(Math.cos(a) * -len * 0.6 + kink * 0.4).toFixed(1)} ${(Math.sin(a) * -len * 0.6).toFixed(1)}`
  );
});
---

<div id="intro" class="intro" aria-hidden="true">
  <div class="intro-buehne">
    <!-- Was durch das Loch zu sehen ist -->
    <div class="intro-bild">
      <Picture
        name="hero"
        alt=""
        widths={[900, 1400, 1920]}
        sizes="100vw"
        eager
        class="h-full w-full object-cover"
      />
    </div>

    <!-- Der Zaun. Weisse Fläche mit ausgespartem Loch, darauf das Geflecht. -->
    <svg
      class="intro-zaun"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid slice"
      role="presentation"
    >
      <defs>
        <mask id="intro-loch">
          <rect width={W} height={H} fill="white"></rect>
          <path d={holePath} fill="black"></path>
        </mask>
      </defs>

      <g mask="url(#intro-loch)">
        <rect width={W} height={H} fill="white"></rect>
        <g
          fill="none"
          stroke="#121820"
          stroke-width="3.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          {wiresDown.map((d) => <path d={d} />)}
          {wiresUp.map((d) => <path d={d} />)}
        </g>
      </g>

      <g fill="none" stroke="#121820" stroke-width="2.6" stroke-linecap="round">
        {stubs.map((d) => <path d={d} />)}
      </g>
    </svg>

    <p class="intro-hinweis">
      <span>Scrollen</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M12 5v13M6 13l6 6 6-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </p>
  </div>
</div>

<style>
  /* Ohne die Kennzeichnung am Wurzelelement bleibt die Sequenz unsichtbar und
     ohne Höhe. Gesetzt wird sie nur vom Skript unten. */
  .intro {
    display: none;
  }

  :global(html[data-intro]) .intro {
    display: block;
    height: 170svh;
  }

  .intro-buehne {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background-color: white;
  }

  .intro-bild {
    position: absolute;
    inset: 0;
  }

  .intro-zaun {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    /* Beide Werte hängen allein am Fortschritt --p, den das Skript setzt. */
    transform: scale(calc(1 + var(--e, 0) * 13));
    opacity: clamp(0, calc((1 - var(--p, 0)) / 0.14), 1);
    will-change: transform, opacity;
  }

  .intro-hinweis {
    position: absolute;
    bottom: max(2rem, env(safe-area-inset-bottom));
    left: 50%;
    display: flex;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-brand-900);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: clamp(0, calc(1 - var(--p, 0) * 4), 1);
  }

  .intro-hinweis svg {
    animation: intro-tipp 1.8s ease-in-out infinite;
  }

  @keyframes intro-tipp {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-intro]) .intro {
      display: none;
    }
  }
</style>

<script>
  const setupIntro = () => {
    const wurzel = document.documentElement;
    const intro = document.getElementById('intro');

    /* Nach einem Seitenwechsel bleibt das Attribut am Wurzelelement stehen.
       Ohne Sequenz auf der neuen Seite bliebe sonst der Kopfbereich verborgen. */
    if (!intro) {
      wurzel.removeAttribute('data-intro');
      wurzel.removeAttribute('data-intro-fertig');
      return;
    }

    const stage = intro.querySelector<HTMLElement>('.intro-buehne');
    if (!stage) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Bei reduzierter Bewegung wird gar nicht erst eingeschaltet. */
    if (reduced.matches) {
      wurzel.removeAttribute('data-intro');
      return;
    }

    /* Beim ersten Aufruf hat das Skript im Kopfbereich das schon gesetzt.
       Hier nur noch für den Fall eines Seitenwechsels zurück auf die
       Startseite. */
    wurzel.setAttribute('data-intro', '');

    const zaun = intro.querySelector<HTMLElement>('.intro-zaun');
    const hinweis = intro.querySelector<HTMLElement>('.intro-hinweis');
    let ticking = false;

    const update = () => {
      ticking = false;
      const strecke = intro.offsetHeight - window.innerHeight;
      if (strecke <= 0) return;

      const p = Math.min(1, Math.max(0, window.scrollY / strecke));

      /* Beschleunigte Kurve: am Anfang bleibt der Zaun fast stehen, gegen Ende
         öffnet sich das Loch schnell. Linear wäre man schon nach einem Drittel
         der Strecke hindurch und der Rest liefe ins Leere. */
      const e = Math.pow(p, 2.6);

      zaun?.style.setProperty('--p', p.toFixed(4));
      zaun?.style.setProperty('--e', e.toFixed(4));
      hinweis?.style.setProperty('--p', p.toFixed(4));

      /* Der Kopfbereich kommt erst, wenn die Sequenz durch ist. */
      document.documentElement.toggleAttribute('data-intro-fertig', p >= 0.98);

      /* Die Bühne wird bewusst nicht ausgeblendet. Durch die klebende
         Positionierung scrollt sie nach dem Durchgang noch eine
         Bildschirmhöhe weiter. Wäre sie dann leer, folgte auf das Loch eine
         weisse Fläche. So bleibt das Aufmacherbild stehen und geht ohne Bruch
         in den Aufmacher darunter über. */
      if (p >= 1) zaun?.style.setProperty('will-change', 'auto');
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    /* Wer mit der Tastatur navigiert, soll nicht erst zwei Bildschirmhöhen
       weit scrollen müssen. Der erste Tabulatorschritt springt an den Inhalt. */
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Tab' || window.scrollY > 40) return;
        window.scrollTo({ top: intro.offsetHeight, behavior: 'auto' });
      },
      { once: true },
    );
  };

  setupIntro();
  document.addEventListener('astro:after-swap', setupIntro);
</script>
