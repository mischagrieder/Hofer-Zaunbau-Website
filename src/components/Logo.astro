---
/**
 * Wortmarke mit vorangestelltem Zaunzeichen.
 *
 * Die Marke ist gesetzt statt als Bild eingebunden: sie bleibt bei jeder
 * Grösse scharf und kostet keinen zusätzlichen Abruf. Alle Teile erben die
 * Farbe vom Umfeld, damit eine einzige Regel im Kopfbereich genügt, um die
 * Marke über dem Aufmacherbild auf Weiss zu stellen. Siehe .logo-* in
 * styles/global.css.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`flex items-center gap-2.5 ${className}`}>
  <svg
    viewBox="0 0 28 28"
    class="h-7 w-7 shrink-0"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M5 24V8l2.5-3.5L10 8v16M18 24V8l2.5-3.5L23 8v16" />
    <path class="logo-accent" d="M2 13h24M2 18.5h24" stroke="currentColor" />
  </svg>

  <span class="flex flex-col leading-none">
    <span class="logo-name font-display text-[1.0625rem] font-bold tracking-[0.06em]">
      HOFER
    </span>
    <span class="logo-sub mt-0.5 text-[0.6875rem] uppercase tracking-[0.22em]">
      Zaunbau
    </span>
  </span>
</span>
