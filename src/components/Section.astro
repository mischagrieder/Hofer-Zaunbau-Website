---
/**
 * Einheitlicher Sektionsrahmen.
 *
 * Hält den vertikalen Rhythmus über alle Seiten identisch und liefert die
 * Flächenfarben. Die Abschnitte wechseln sich bewusst ab, damit die Seite
 * nicht als eine durchgehende weisse Fläche wirkt.
 */
interface Props {
  id?: string;
  tone?: 'white' | 'tint' | 'dark' | 'deep';
  class?: string;
  labelledby?: string;
}

const { id, tone = 'white', class: className = '', labelledby } = Astro.props;

const tones = {
  white: 'bg-white text-ink',
  // Sehr helles Blau, hebt einen Abschnitt ab ohne ihn grau wirken zu lassen.
  tint: 'bg-brand-50 text-ink',
  dark: 'bg-brand-900 text-white',
  deep: 'bg-brand-950 text-white',
} as const;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class={`relative overflow-hidden py-(--spacing-section) ${tones[tone]} ${className}`}
>
  <slot />
</section>
