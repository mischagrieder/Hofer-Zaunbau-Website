---
/**
 * Einheitlicher Sektionsrahmen. Hält den vertikalen Rhythmus über alle Seiten
 * identisch, damit Abstände nirgends von Hand gesetzt werden müssen.
 */
interface Props {
  id?: string;
  tone?: 'paper' | 'white' | 'dark';
  class?: string;
  labelledby?: string;
}

const { id, tone = 'paper', class: className = '', labelledby } = Astro.props;

const tones = {
  paper: 'bg-paper text-ink',
  white: 'bg-white text-ink',
  dark: 'bg-brand-900 text-grey-100',
} as const;
---

<section
  id={id}
  aria-labelledby={labelledby}
  class={`py-(--spacing-section) ${tones[tone]} ${className}`}
>
  <slot />
</section>
